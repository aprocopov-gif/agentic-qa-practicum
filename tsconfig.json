{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "playwright.config.ts",
    "support/**/*.ts",
    "test-data/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "evals"]
}
